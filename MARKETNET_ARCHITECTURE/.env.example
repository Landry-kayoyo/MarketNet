# Application
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketnet
POSTGRES_USER=marketnet
POSTGRES_PASSWORD=marketnet
DATABASE_URL=postgresql://marketnet:marketnet@localhost:5432/marketnet?schema=public
DIRECT_URL=postgresql://marketnet:marketnet@localhost:5432/marketnet?schema=public

# JWT / Security
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace-me-with-another-random-secret
REFRESH_TOKEN_TTL=30d

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=MarketNet

# Production (Supabase + Vercel):
# Set DATABASE_URL to the Supabase Transaction pooler URL (port 6543) and
# DIRECT_URL to the Session pooler URL (port 5432) for Prisma migrations.
# Keep NEXT_PUBLIC_API_URL unset in Vercel so the browser uses this same domain.
